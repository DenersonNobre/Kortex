# Artefatos de build, cache e IDE (necessário repetir pois .pubignore sobrescreve .gitignore)
.dart_tool/
build/
.idea/
*.iml
.packages
.flutter-plugins
.flutter-plugins-dependencies
.metadata
*.log

# Documentação interna e governança de agentes (não empacotar para pub.dev)
docs/
AGENTS.md
CHECKPOINT.md
LEARNINGS.md
.vscode/
.gitattributes
example/test/

# Prova de conceito de desenvolvimento (não faz parte da API publicada;
# mantém imports `package:poc/...` que não resolvem para quem instala o
# pacote — por isso não pode embarcar no archive do pub.dev)
poc/

# Runner nativo do Windows (gerado pelo `flutter create`, boilerplate C++/CMake;
# fica no Git para permitir `flutter run -d windows`, mas não no archive)
example/windows/
